<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--    콘솔 로그 Appender-->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- INFO 로그 Appender -->
    <appender name="INFO_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/info.log</file>
        <!-- INFO 레벨의 로그만 허용 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>info</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <!--로그 파일 7일 동안 저장-->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/info-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- WARN 로그 Appender -->
    <appender name="WARN_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/warn.log</file>
        <!-- WARN 레벨의 로그만 허용 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>warn</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <!--로그 파일 7일 동안 저장-->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/warn-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 모든 DEBUG 이상 로그 Appender -->
    <appender name="DEBUG_ALL_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/debug_all.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>debug</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <!--로그 파일 7일 동안 저장-->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/debug-all-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 모든 WARN 이상 로그 Appender -->
    <appender name="WARN_ALL_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/warn_all.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>warn</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <!--로그 파일 7일 동안 저장-->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/warn-all-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 모든 ERROR 이상 로그 Appender -->
    <appender name="ERROR_ALL_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/error_all.log</file>
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <!--로그 파일 7일 동안 저장-->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/error_all-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <!-- ERROR 레벨 이상의 로그만 허용 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!--Trace, Debug, Info, Warn, Error 레벨 중 DEBUG 레벨 이상의 로그만 출력 및 저장-->
    <!--서비스와 관련된 com.eazy.pay 패키지의 로그만 출력 및 저장-->
    <logger name="com.eazy.pay" level="DEBUG" additivity="false">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="INFO_LOG" />
        <appender-ref ref="WARN_LOG" />
    </logger>

    <!--모든 로그 저장-->
    <root level="DEBUG">
        <appender-ref ref="DEBUG_ALL_LOG" />
        <appender-ref ref="WARN_ALL_LOG" />
        <appender-ref ref="ERROR_ALL_LOG" />
    </root>
</configuration>